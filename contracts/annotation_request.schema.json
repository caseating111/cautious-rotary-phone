{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation_request.schema.json",
  "title": "AnnotationRequest",
  "type": "object",
  "required": ["contract_version", "image_uid", "layout_id", "labels"],
  "properties": {
    "contract_version": {"const": 1},
    "image_uid": {"type": "string", "minLength": 1},
    "layout_id": {"type": "string", "minLength": 1},
    "labels": {
      "type": "object",
      "properties": {
        "date": {"type": ["string", "null"]},
        "plate": {"type": ["string", "null"]},
        "media": {"type": ["string", "null"]},
        "condition": {"type": ["string", "null"]},
        "session": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "editable_overlay": {"type": "boolean"},
        "output_format": {"type": "string"},
        "strain_text_rotation_degrees": {"type": "number"},
        "vertical_text_rotation_degrees": {"type": "number"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
