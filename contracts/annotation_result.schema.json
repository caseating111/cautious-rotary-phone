{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "annotation_result.schema.json",
  "title": "AnnotationResult",
  "description": "Durable accepted annotation record. In-memory preview_image pixels are deliberately excluded.",
  "type": "object",
  "required": [
    "contract_version",
    "image_uid",
    "layout_id",
    "status",
    "output_dimensions",
    "output_path",
    "source_image_ref",
    "grid_asset_id",
    "warnings",
    "placements",
    "preset_used",
    "rendered_labels"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "image_uid": {"type": "string", "minLength": 1},
    "layout_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PROPOSED", "ACCEPTED"]},
    "output_dimensions": {
      "type": "array",
      "items": {"type": "integer", "minimum": 1},
      "minItems": 2,
      "maxItems": 2
    },
    "output_path": {"type": ["string", "null"]},
    "source_image_ref": {"type": ["string", "null"]},
    "grid_asset_id": {"type": ["string", "null"]},
    "warnings": {"type": "array", "items": {"type": "string"}},
    "placements": {"type": "object", "additionalProperties": true},
    "preset_used": {"type": "string", "minLength": 1},
    "rendered_labels": {"type": "object", "additionalProperties": true},
    "annotation_request": {"$ref": "annotation_request.schema.json"},
    "preset": {"type": ["object", "null"], "additionalProperties": true},
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": false
}
