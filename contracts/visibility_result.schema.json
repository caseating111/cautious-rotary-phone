{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visibility_result.schema.json",
  "title": "VisibilityResult",
  "description": "Durable metadata for a proposed, accepted, skipped, or manual-review whole-image display adjustment.",
  "type": "object",
  "required": [
    "contract_version",
    "image_uid",
    "preset_name",
    "method",
    "status",
    "needs_manual_review",
    "parameters",
    "statistics",
    "output_path",
    "source_image_ref",
    "grid_asset_id",
    "output_dimensions"
  ],
  "properties": {
    "contract_version": {"const": 1},
    "image_uid": {"type": "string", "minLength": 1},
    "preset_name": {"type": "string", "minLength": 1},
    "method": {"const": "background_aware_linear"},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "MANUAL_REVIEW", "SKIPPED"]},
    "needs_manual_review": {"type": "boolean"},
    "manual_review_reason": {"type": ["string", "null"]},
    "parameters": {"type": "object", "additionalProperties": {"type": "number"}},
    "grid_roi": {"type": ["object", "null"], "additionalProperties": {"type": "number"}},
    "statistics": {"type": "object", "additionalProperties": {"type": "number"}},
    "output_path": {"type": ["string", "null"]},
    "source_image_ref": {"type": ["string", "null"]},
    "grid_asset_id": {"type": ["string", "null"]},
    "output_dimensions": {
      "type": ["array", "null"],
      "items": {"type": "integer", "minimum": 1},
      "minItems": 2,
      "maxItems": 2
    },
    "source_sha256": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"}
  },
  "additionalProperties": false
}
