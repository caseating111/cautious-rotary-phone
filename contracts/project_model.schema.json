{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project_model.schema.json",
  "title": "ProjectModel",
  "type": "object",
  "required": ["contract_version", "sessions", "images"],
  "properties": {
    "contract_version": {"const": 1},
    "sessions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["session_uid", "exp", "date"],
        "properties": {
          "session_uid": {"type": "string", "minLength": 1},
          "exp": {"type": "string", "minLength": 1},
          "date": {"type": "string", "minLength": 1},
          "time": {"type": ["string", "null"]},
          "name": {"type": ["string", "null"]},
          "arrangement": {"type": ["string", "null"]},
          "annotation_set": {"type": ["string", "null"]}
          ,"id": {"type": ["string", "null"]}
          ,"sample_description": {"type": ["string", "null"]}
          ,"date": {"type": ["string", "null"]}
          ,"figure_description_label": {"type": ["string", "null"]}
          ,"filename_status": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "images": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["image_uid", "session_uid", "image_number", "original", "exp", "set"],
        "properties": {
          "image_uid": {"type": "string", "minLength": 1},
          "session_uid": {"type": "string", "minLength": 1},
          "image_number": {"type": "integer", "minimum": 1},
          "original": {"type": "string", "minLength": 1},
          "working_filename": {"type": ["string", "null"]},
          "exp": {"type": "string", "minLength": 1},
          "set": {"type": "string", "minLength": 1},
          "media": {"type": ["string", "null"]},
          "condition": {"type": ["string", "null"]},
          "rep": {"type": ["integer", "string", "null"]},
          "arrangement": {"type": ["string", "null"]},
          "annotation_set": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "layouts": {
      "type": "object",
      "additionalProperties": {"$ref": "plate_layout.schema.json"}
    },
    "diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "string", "minLength": 1},
          "annotation_set": {"type": "string"},
          "message": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
