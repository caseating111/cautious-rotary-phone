{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rotation_result.schema.json",
  "title": "RotationResult",
  "type": "object",
  "required": ["contract_version", "status", "angle_degrees", "method", "needs_manual_review"],
  "properties": {
    "contract_version": {"const": 1},
    "status": {"enum": ["PROPOSED", "ACCEPTED", "SKIPPED"]},
    "image_uid": {"type": ["string", "null"]},
    "angle_degrees": {"type": "number"},
    "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "method": {"type": "string", "minLength": 1},
    "needs_manual_review": {"type": "boolean"},
    "source_path": {"type": ["string", "null"]},
    "output_path": {"type": ["string", "null"]},
    "transform": {"type": ["object", "null"], "required": ["model", "coordinate_space", "centre", "expand", "matrix", "source_dimensions", "output_dimensions", "clipping_policy"], "properties": {"model": {"type": "string", "minLength": 1}, "coordinate_space": {"const": "source_image_pixels"}, "centre": {"type": "object", "required": ["x", "y"], "properties": {"x": {"type": "number"}, "y": {"type": "number"}}, "additionalProperties": false}, "expand": {"const": false}, "matrix": {"type": "array", "minItems": 3, "maxItems": 3}, "source_dimensions": {"type": "array", "minItems": 2, "maxItems": 2}, "output_dimensions": {"type": "array", "minItems": 2, "maxItems": 2}, "clipping_policy": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "diagnostics": {
      "type": "object",
      "description": "Non-pixel numeric/text diagnostics only.",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
